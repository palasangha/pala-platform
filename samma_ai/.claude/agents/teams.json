    "optimization": {
      "name": "Optimization Team",
      "description": "Token efficiency, model selection, cost management, context optimization",
      "lead": "optimization-lead",
      "agents": {
        "optimization-lead": {
          "name": "Optimization Lead",
          "description": "Strategy for token/cost optimization, model selection decisions, team coordination",
          "skills": ["/optimize-strategy", "/cost-report", "/model-recommend"],
          "tools": ["Read", "Glob", "Grep", "Edit", "Write"],
          "responsibilities": [
            "Define optimization strategy",
            "Review token usage patterns",
            "Recommend model switches",
            "Coordinate sub-agents"
          ]
        },
        "token-optimizer": {
          "name": "Token Optimizer",
          "description": "Minimize token usage, compress context, prune unnecessary content",
          "skills": ["/compress-context", "/prune-content", "/token-count"],
          "tools": ["Read", "Glob", "Grep", "Edit"],
          "rules": {
            "max_context_tokens": 50000,
            "compression_threshold": 0.7,
            "prune_duplicates": true
          }
        },
        "model-selector": {
          "name": "Model Selector",
          "description": "Auto-select best model for task based on complexity and requirements",
          "skills": ["/select-model", "/model-compare", "/complexity-assess"],
          "tools": ["Read", "Glob", "Grep"],
          "model_rules": {
            "haiku": {
              "use_for": ["simple lookups", "formatting", "quick answers", "file listing"],
              "max_complexity": "low",
              "cost_priority": "high"
            },
            "sonnet": {
              "use_for": ["code generation", "standard development", "moderate analysis"],
              "max_complexity": "medium",
              "cost_priority": "balanced"
            },
            "opus": {
              "use_for": ["complex architecture", "deep analysis", "planning", "Dhamma responses"],
              "max_complexity": "high",
              "cost_priority": "quality"
            }
          }
        },
        "context-manager": {
          "name": "Context Manager",
          "description": "Manage what context is loaded, prioritize relevant files, manage memory",
          "skills": ["/context-load", "/context-prune", "/context-prioritize"],
          "tools": ["Read", "Glob", "Grep"],
          "context_rules": {
            "always_load": ["INIT.md", "CONTEXT.md", "MEMORY.md"],
            "load_on_demand": ["daily logs", "insight files", "code files"],
            "max_files_in_context": 20
          }
        },
        "cost-tracker": {
          "name": "Cost Tracker",
          "description": "Track token usage, report costs, suggest optimizations, monitor budgets",
          "skills": ["/track-usage", "/cost-report", "/budget-alert"],
          "tools": ["Read", "Glob", "Grep", "Edit", "Write"],
          "tracking": {
            "log_file": ".claude/memory/usage_log.json",
            "report_frequency": "daily",
            "alert_thresholds": {
              "daily_tokens": 500000,
              "session_tokens": 100000
            }
          }
        }
      }
