# Samma AI Docker Configuration
# Copy this file to .env before running: cp .env.docker .env

# ──────────────────────────────────────────────────────────────
# Flask Configuration
# ──────────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production

# ──────────────────────────────────────────────────────────────
# Database Ports (Custom ports for Docker)
# ──────────────────────────────────────────────────────────────
# MongoDB: Port 27018 (exposed), 27017 (internal)
# Qdrant: Port 6334 (exposed), 6333 (internal)

QDRANT_API_KEY=qdrant_key

# ──────────────────────────────────────────────────────────────
# Claude API (Anthropic)
# ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-YOUR-KEY-HERE
CLAUDE_MODEL=claude-sonnet-4-20250514

# ──────────────────────────────────────────────────────────────
# Ollama (Local Model)
# ──────────────────────────────────────────────────────────────
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=deepseek-r1:32b

# ──────────────────────────────────────────────────────────────
# OpenAI API (Optional)
# ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ──────────────────────────────────────────────────────────────
# GitHub Copilot (Optional)
# ──────────────────────────────────────────────────────────────
COPILOT_ENDPOINT=https://models.inference.ai.azure.com/chat/completions
COPILOT_API_KEY=
COPILOT_MODEL=gpt-4o-mini

# ──────────────────────────────────────────────────────────────
# Vector Database & Embeddings
# ──────────────────────────────────────────────────────────────
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_BATCH_SIZE=64
VECTOR_SEARCH_TOP_K=5

# ──────────────────────────────────────────────────────────────
# Node Environment
# ──────────────────────────────────────────────────────────────
NODE_ENV=development
