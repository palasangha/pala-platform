# Example environment variables for Pala Platform Storage Agent

# --- S3/MinIO File Storage (Primary) ---
FILE_STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:3900
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=pala-local
S3_REGION=us-east-1

# --- S3/MinIO File Storage (Replica) ---
# For local dev: same MinIO instance, different bucket
S3_REPLICA_ENDPOINT=http://localhost:3900
S3_REPLICA_ACCESS_KEY=minioadmin
S3_REPLICA_SECRET_KEY=minioadmin
S3_REPLICA_BUCKET=pala-local-replica
S3_REPLICA_REGION=us-east-1
S3_ENABLE_REPLICA=true

# --- Metadata DB (Primary) ---
METADATA_DB_PROVIDER=sqlite
SQLITE_DB_PATH=./storage_metadata.db

# --- Metadata DB (Replica) ---
SQLITE_REPLICA_DB_PATH=./storage_metadata_replica.db
SQLITE_ENABLE_REPLICA=true

# --- General ---
LOGLEVEL=DEBUG
